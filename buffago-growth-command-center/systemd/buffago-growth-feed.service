[Unit]
Description=Buffago restricted dashboard feed refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=branden
Group=branden
WorkingDirectory=/opt/buffago-growth-command-center
ExecStart=/usr/bin/python3 /opt/buffago-growth-command-center/adapters/pull_feed.py
TimeoutStartSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/buffago-growth-command-center/data
UMask=0077
