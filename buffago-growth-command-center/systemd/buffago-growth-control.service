[Unit]
Description=Buffago Growth Local Control
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=branden
Group=branden
WorkingDirectory=/opt/buffago-growth-command-center
EnvironmentFile=/etc/buffago-growth-command-center.env
ExecStart=/usr/bin/python3 /opt/buffago-growth-command-center/control_server.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
