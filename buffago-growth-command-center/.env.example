# Start safely without credentials.
BUFFAGO_GROWTH_DEMO=true
BUFFAGO_GROWTH_FULLSCREEN=true
BUFFAGO_REFRESH_SECONDS=600
BUFFAGO_GROWTH_TIMEOUT_SECONDS=12
BUFFAGO_GROWTH_STALE_AFTER_SECONDS=1200

# Live mode: use the URL shortcut or the full function URL.
BUFFAGO_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# BUFFAGO_GROWTH_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/buffago-growth-snapshot

# Required for live display; sent only in X-Buffago-Dashboard-Key.
BUFFAGO_DASHBOARD_DEVICE_TOKEN=
# Optional authenticated-user debugging only; not required for normal Pi operation.
# BUFFAGO_GROWTH_ACCESS_TOKEN=
# BUFFAGO_SUPABASE_ANON_JWT=

# Optional path overrides.
# BUFFAGO_GROWTH_CACHE_PATH=/var/lib/buffago-growth/snapshot-cache.json
# BUFFAGO_GROWTH_LOCAL_CONFIG=/opt/buffago-growth-command-center/data/growth_config.json


# LAN-only. DO NOT PORT-FORWARD PORT 8787 TO THE INTERNET.
BUFFAGO_CONTROL_ENABLED=true
BUFFAGO_CONTROL_HOST=0.0.0.0
BUFFAGO_CONTROL_PORT=8787
# Scoped only to growth_admin:write; never reuse the display device token.
BUFFAGO_GROWTH_CONTROLLER_TOKEN=
