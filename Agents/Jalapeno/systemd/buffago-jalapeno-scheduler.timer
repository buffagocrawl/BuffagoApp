[Unit]
Description=Eastern evening Jalapeno publishing, metrics and ledger health checks

[Timer]
OnCalendar=*-*-* 19:30,50:00 America/New_York
OnCalendar=*-*-* 20:10,30,50:00 America/New_York
OnCalendar=*-*-* 21:10,15,45:00 America/New_York
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=buffago-jalapeno-scheduler.service

[Install]
WantedBy=timers.target
