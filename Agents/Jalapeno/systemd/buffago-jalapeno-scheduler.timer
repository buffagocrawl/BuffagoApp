[Unit]
Description=Eastern spotlight and evening Jalapeno publishing, metrics and health

[Timer]
OnCalendar=Mon,Wed,Fri,Sat,Sun *-*-* 12:00,20,40:00 America/New_York
OnCalendar=Mon,Wed,Fri,Sat,Sun *-*-* 13:05:00 America/New_York
OnCalendar=*-*-* 19:30,50:00 America/New_York
OnCalendar=*-*-* 20:10,30,50:00 America/New_York
OnCalendar=*-*-* 21:10,15,45:00 America/New_York
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=buffago-jalapeno-scheduler.service

[Install]
WantedBy=timers.target
