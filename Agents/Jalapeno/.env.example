# Required for Phase 2 validation and future DB writes
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI backend overrides
# Jalapeno calls a Supabase Edge Function instead of talking to OpenAI directly.
JALAPENO_AI_FUNCTION_URL=
JALAPENO_AI_FUNCTION_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
USE_OPENAI=true
AI_ENABLED=true
ENABLE_AI_COPY=true
JALAPENO_EMERGENCY_TEMPLATE_FALLBACK=false

META_APP_ID=
META_APP_SECRET=
META_LONG_LIVED_ACCESS_TOKEN=

FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Optional email reports through Resend
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=
RESEND_API_KEY=

# Optional runtime override
TIMEZONE=
JALAPENO_DRY_RUN=true
JALAPENO_IMAGE_POST_TIME=16:00
JALAPENO_VIDEO_POST_TIME=20:00
JALAPENO_VIDEO_BUCKET=jalapeno-wing-videos
JALAPENO_VIDEO_RECENT_REUSE_DAYS=7
