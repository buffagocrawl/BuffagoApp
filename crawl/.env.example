EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Never commit real values; configure Expo/EAS and local ignored env files.
# Native Maps SDK for Android: restrict to com.buffago.app and Play App Signing SHA-1.
EXPO_PUBLIC_GOOGLE_ANDROID_API_KEY=
# Maps SDK for iOS: restrict to bundle ID com.buffago.app.
EXPO_PUBLIC_GOOGLE_IOS_API_KEY=
# Legacy walking Directions variable; this will move server-side separately.
EXPO_PUBLIC_GOOGLE_API_KEY=
EXPO_PUBLIC_STRICT_ENV=false
EXPO_PUBLIC_USE_PROXY=false
EXPO_PUBLIC_REFERRAL_BASE_URL=https://buffago.com
EXPO_PUBLIC_REFERRAL_DOMAIN=buffago.com
EXPO_PUBLIC_ENABLE_REFERRALS=false

# Public social destinations used by Home CTAs. Configure both the native
# deep-link target and the HTTPS browser fallback; do not put Meta tokens here.
EXPO_PUBLIC_BUFFAGO_INSTAGRAM_DEEP_LINK=
EXPO_PUBLIC_BUFFAGO_INSTAGRAM_URL=
EXPO_PUBLIC_BUFFAGO_FACEBOOK_DEEP_LINK=
EXPO_PUBLIC_BUFFAGO_FACEBOOK_URL=

# Required for production association-file generation/deployment.
EXPO_PUBLIC_APPLE_TEAM_ID=
EXPO_PUBLIC_ANDROID_RELEASE_SHA256=
EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/
EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.buffago.app

# Supabase Edge Function secrets only. Do not expose these through EXPO_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_PLACES_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
