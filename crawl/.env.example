EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Public by design when compiled. Use only a tightly API- and app-restricted
# client key. Do not reuse a server/web-service key here.
EXPO_PUBLIC_GOOGLE_API_KEY=
EXPO_PUBLIC_STRICT_ENV=false
EXPO_PUBLIC_USE_PROXY=false
EXPO_PUBLIC_REFERRAL_BASE_URL=https://buffago.com
EXPO_PUBLIC_REFERRAL_DOMAIN=buffago.com
EXPO_PUBLIC_ENABLE_REFERRALS=false

# Required for production association-file generation/deployment.
EXPO_PUBLIC_APPLE_TEAM_ID=
EXPO_PUBLIC_ANDROID_RELEASE_SHA256=
EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/
EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.buffago.app

# Supabase Edge Function secrets only. Do not expose these through EXPO_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_PLACES_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
