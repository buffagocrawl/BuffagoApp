{
  "name": "crawl",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:quick-rating": "node ./scripts/test-quick-rating.js",
    "test:auth": "node --test --experimental-default-type=module ./tests/auth/*.test.js",
    "test:analytics": "node --test --experimental-default-type=module ./tests/analytics/*.test.js",
    "test:growth": "node --test --experimental-default-type=module ./tests/auth/growth-loops.test.js",
    "test:rls": "node --test --experimental-default-type=module ./tests/database/*.test.js",
    "migration:integrity": "node ./scripts/check-migration-integrity.mjs",
    "database:contract": "node ./scripts/generate-baseline-contract.mjs",
    "database:current-contract": "node ./scripts/generate-current-schema-contract.mjs",
    "database:harness": "node ./scripts/database-runtime-harness.mjs",
    "database:fingerprint": "node ./scripts/schema-fingerprint.mjs",
    "owner-validation": "node ./scripts/owner-validation.mjs",
    "typecheck": "tsc --noEmit",
    "security:scan": "node ../scripts/security/scan-secrets.mjs",
    "security:scan-staged": "node ../scripts/security/scan-secrets.mjs --staged",
    "cayenne:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\scripts\\cayenne\\check-prerequisites.ps1",
    "cayenne:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\scripts\\cayenne\\run.ps1 -Suite smoke -Environment production-readonly",
    "cayenne:serrano": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\scripts\\cayenne\\run.ps1 -Suite smoke -Environment production-readonly -SerranoReview",
    "cayenne:contracts": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\scripts\\cayenne\\validate-contracts.ps1",
    "cayenne:selectors": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\scripts\\cayenne\\validate-selectors.ps1"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7",
    "@react-navigation/native-stack": "^7",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "babel-preset-expo": "~54.0.10",
    "dayjs": "^1.11.18",
    "expo": "~54.0.36",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-env": "^1.1.1",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-network": "~8.0.8",
    "expo-notifications": "0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.8",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "nanoid": "^5.1.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-paper": "^5.14.5",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "baseline-browser-mapping": "^2.9.6",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
