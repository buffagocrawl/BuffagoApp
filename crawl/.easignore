# VCS / IDE
.git/
.vscode/
.idea/
.vs/

# Local dependencies and Expo state. EAS must install Linux dependencies from
# package-lock.json rather than receive a Windows node_modules tree.
node_modules/
.expo/
.expo-shared/

# Native projects are generated on EAS from the current app.config.js and keys.
android/
ios/
# Native build outputs and caches.
.gradle/
android/.gradle/
android/build/
android/app/build/
android/.cxx/
android/app/.cxx/
**/.cxx/

# Generated output and test artifacts
dist/
output/
build/
web-build/
artifacts/
test-results/
screenshots/
coverage/
*.log
*.tsbuildinfo
.tmp/
.pytest_cache/
__pycache__/
**/__pycache__/

# Local environment and platform state
local.properties
.env
.env.*
!.env.example
*.env
*.env.*
!.env.example

# OS cruft
.DS_Store
Thumbs.db
