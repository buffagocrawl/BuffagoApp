# This repository contains the Expo app in crawl/.  EAS currently stages from
# this Git root, so these root-relative rules are the effective archive guard.
.git/
Agents/
.agents/
.worktrees/
.vs/
.tmp/
# Generated native projects must be regenerated from app.config.js on EAS.
# Including local Android sources can bypass Maps key injection during prebuild.
crawl/android/
crawl/ios/
crawl/output/
tmp/
artifacts/
evidence/
output/
**/.pytest_cache/
**/__pycache__/
**/node_modules/
**/.expo/
**/.expo-shared/
**/.gradle/
**/.cxx/
**/build/
**/dist/
**/web-build/
**/coverage/
**/test-results/
**/screenshots/
*.log
**/local.properties
**/.env
**/.env.*
!**/.env.example
