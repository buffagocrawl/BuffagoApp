# Initial emulator and normal CLI startup reproduced manifest timeout; baseline logs retained.
emulator -avd Medium_Phone_API_36.1 -no-window -no-audio -no-snapshot-save
# In crawl; all env values are process-local. Key below is synthetic, not an account credential.
$env:EXPO_NO_DOTENV='1'
$env:EXPO_PUBLIC_ONBOARDING_V2='true'
$env:EXPO_PUBLIC_ONBOARDING_WING_SHOT_INVITE='true'
