node node_modules/expo/bin/cli start --dev-client --port 8081 --localhost
curl.exe --max-time 5 http://127.0.0.1:8081/status
curl.exe --max-time 8 -H 'expo-platform: android' -H 'accept: application/expo+json' http://127.0.0.1:8081/
# Outcome: /status 200; manifest curl timeout (8s, then 10s); first JS not yet executing.
# Read-only Node inspector sampled Metro FallbackWatcher _watchdir/fs.watch and _register/micromatch.
# No SDK source patched; no package versions changed.

# Dedicated fresh AVD attempt; stopped after Android package service/StorageManager failures.
& "$env:ANDROID_HOME/cmdline-tools/latest/bin/avdmanager.bat" create avd --name Buffago_Onboarding_QA --package 'system-images;android-36.1;google_apis_playstore;x86_64' --device pixel_4
emulator -avd Buffago_Onboarding_QA -no-window -no-audio -no-snapshot -cores 4 -memory 3072
adb -s emulator-5556 install crawl/android/app/build/outputs/apk/debug/app-debug.apk
adb -s emulator-5556 emu kill

# Recovered target; no AVD directory deleted or wiped.
emulator -avd Medium_Phone_API_36.1 -no-window -no-audio -no-snapshot-save -cores 4 -gpu host
adb -s emulator-5554 shell getprop sys.boot_completed
adb -s emulator-5554 shell service check package
adb -s emulator-5554 install -r crawl/android/app/build/outputs/apk/debug/app-debug.apk
# Existing emulator data was privately archived with run-as tar BEFORE the first pm clear.
# Second campaign backed up native-created rated QA data, then restored it afterwards.
# No physical install cleared; private archives stay in ignored crawl/.expo.
adb -s emulator-5554 shell am force-stop com.buffago.app
adb -s emulator-5554 exec-out run-as com.buffago.app tar -cf - .
adb -s emulator-5554 shell pm clear com.buffago.app

# Final local Metro mode (in crawl, same process-local flags as above):
$env:REACT_NATIVE_PACKAGER_HOSTNAME='127.0.0.1'
node node_modules/expo/bin/cli start --dev-client --offline --max-workers 2 --port 8081
# --offline and --localhost cannot be combined by this Expo CLI; initial rejected attempt corrected.
# Wait for complete server readiness. /status alone is not readiness.
node scripts/qa/probe-android-metro.mjs http://127.0.0.1:8081
# Final successful probe JSON: manifest/bundle HTTP 200, 16875623 bundle bytes, 1278ms.
adb -s emulator-5554 reverse tcp:8081 tcp:8081
adb -s emulator-5554 shell am start -a android.intent.action.VIEW -d 'buffago://expo-development-client/?url=http%3A%2F%2F127.0.0.1%3A8081' com.buffago.app
