        "service_role=arwdDxtm/postgres"
      ],
      "name": "mango_pending_restaurants",
      "options": [
        "security_invoker=true"
      ],
      "definition": " SELECT id,\n    user_id,\n    state_id,\n    restaurant_name,\n    address,\n    created_at,\n    verification_evidence\n   FROM destination_suggestions s\n  WHERE (NOT (EXISTS ( SELECT 1\n           FROM restaurant_suggestion_reviews r\n          WHERE (r.suggestion_id = s.id))));"
    }
  ],
